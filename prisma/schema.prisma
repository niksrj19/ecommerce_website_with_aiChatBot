// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MANAGER
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  googleId            String   @unique @map("google_id")
  email_verified       Boolean? @map("email_verified")
  name                String?
  avatar             String?
  hashedRefreshToken  String?  @map("hashed_refresh_token")
  role                Role     @default(USER)
  orders              Order[]  // User to Orders relation
  addresses           Address[] // One-to-Many relation to Address
  carts               Cart[]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id            String                      @id @default(uuid())
  title         String
  slug          String                      @unique
  description   String                      @db.Text
  brand         String
  brandId       String                      @map("brand_id")
  brandRef      Brand                       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category      String
  categoryId    String                      @map("category_id")
  categoryRef   Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  specs         Json                        @default("{}")
  price         Decimal                     @db.Decimal(10, 2)
  imageUrl      String                      @map("image_url")
  sizes         String[]
  colors        String[]
  inStock       Boolean                     @default(true) @map("in_stock")
  salesCount    Int                         @default(0) @map("sales_count")
  isFeatured    Boolean                     @default(false) @map("is_featured")
  embedding     Unsupported("vector(1536)")?
  searchVector  Unsupported("tsvector")?    @map("search_vector")
  images        ProductImage[]
  orderItems    OrderItem[]    // Relation to OrderItem
  inventory     Inventory[]
  variants      ProductVariant[]
  reviewStats   ProductReviewStats?
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  @@index([brandId])
  @@index([categoryId])
  @@index([category])
  @@index([brand])
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  altText   String?  @map("alt_text")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model Inventory {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?  @unique @map("variant_id")
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  categorySku     String   @map("category_sku")
  color           String?
  size            String?
  quantityInStock Int      @default(0) @map("quantity_in_stock")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  reserved        Int      @default(0)
  storeId         String   @map("store_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([storeId, productId, categorySku])
  @@index([productId])
  @@index([storeId])
  @@map("inventory")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  logoUrl     String?   @map("logo_url")
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("brands")
}

model Category {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  parentId    String?     @map("parent_id")
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]  @relation("CategoryTree")
  products    Product[]
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([isActive, name])
  @@map("categories")
}

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String    @unique
  price       Decimal   @db.Decimal(10, 2)
  size        String?
  color       String?
  attributes  Json      @default("{}")
  isActive    Boolean   @default(true) @map("is_active")
  inventory   Inventory?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductReviewStats {
  id             String   @id @default(uuid())
  productId      String   @unique @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  averageRating  Decimal  @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount    Int      @default(0) @map("review_count")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("product_review_stats")
}


model Order {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentStatus   PaymentStatus  @default(PENDING) @map("payment_status")
  paymentMethod   String         @map("payment_method")
  totalAmount     Decimal        @map("total_amount") @db.Decimal(10, 2)
  addressId       String?       @map("address_id")
  address         Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  status          OrderStatus   @default(PENDING)
  shippingAddress Json          @map("shipping_address") // Immutable snapshot at time of purchase
  
  gatewayOrderId  String?       @unique @map("gateway_order_id")
  paymentId       String?       @unique @map("payment_id")
  items           OrderItem[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([gatewayOrderId])
  @@index([paymentId])
  @@map("orders")
  

  
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  title     String   // Snapshot of title at time of purchase
  size      String
  color     String
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2) // Authoritative price snapshot
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Address {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName           String   @map("first_name")
  lastName            String?  @map("last_name")
  phoneNumber         String   @map("phone_number")
  addressLine1        String   @map("address_line1")
  addressLine2        String?  @map("address_line2")
  pincode             String
  state               String
  country             String   @default("India")
  deliveryInstruction String?  @map("delivery_instruction")
  isPrimary           Boolean  @default(false) @map("is_primary")
  orders              Order[]  // Relation to orders placed using this address
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("addresses")
}



// prisma/schema.prisma

enum HitlStatus {
  PENDING
  APPROVED
  REJECTED
}

model HitlApproval {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  sessionId   String     @map("session_id")
  actionType  String     @map("action_type") // e.g. "ISSUE_REFUND"
  payload     Json       // Tool arguments & contextual snapshot
  amount      Decimal?   @db.Decimal(10, 2)
  status      HitlStatus @default(PENDING)
  reviewedBy  String?    @map("reviewed_by")
  rejectionReason String? @map("rejection_reason")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("hitl_approvals")
}

model KnowledgeDocument {
  id          String                      @id @default(uuid())
  title       String
  content     String                      @db.Text
  minRole     Role                        @default(USER) @map("min_role")
  department  String                      @default("support")
  embedding   Unsupported("vector(1536)")?
  searchVector Unsupported("tsvector")?   @map("search_vector")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  @@map("knowledge_documents")
}

model ContactInquiry {
  id          String        @id @default(uuid())
  name        String
  email       String
  topic       String
  orderNumber String?       @map("order_number")
  message     String        @db.Text
  status      InquiryStatus @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@map("contact_inquiries")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique @map("user_id")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique @map("session_id")
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantKey String   @map("variant_key")
  productId  String   @map("product_id")
  size       String
  color      String
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([cartId, variantKey])
  @@index([productId])
  @@map("cart_items")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  message   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, id])
  @@map("chat_messages")
}
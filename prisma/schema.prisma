// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MANAGER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  googleId            String   @unique @map("google_id")
  hashedRefreshToken  String?  @map("hashed_refresh_token")
  role                Role     @default(USER)
  orders              Order[]  // User to Orders relation
  addresses           Address[] // One-to-Many relation to Address
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id            String                      @id @default(uuid())
  title         String
  description   String                      @db.Text
  brand         String
  category      String
  price         Decimal                     @db.Decimal(10, 2)
  imageUrl      String                      @map("image_url")
  sizes         String[]
  colors        String[]
  inStock       Boolean                     @default(true) @map("in_stock")
  salesCount    Int                         @default(0) @map("sales_count")
  isFeatured    Boolean                     @default(false) @map("is_featured")
  embedding     Unsupported("vector(1536)")?
  searchVector  Unsupported("tsvector")?    @map("search_vector")
  images        ProductImage[]
  orderItems    OrderItem[]    // Relation to OrderItem
  inventory     Inventory[]
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  @@index([category])
  @@index([brand])
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  altText   String?  @map("alt_text")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model Inventory {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categorySku     String   @map("category_sku")
  color           String?
  size            String?
  quantityInStock Int      @default(0) @map("quantity_in_stock")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  reserved        Int      @default(0)
  storeId         String   @map("store_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([storeId, productId, categorySku])
  @@index([productId])
  @@index([storeId])
  @@map("inventory")
}


model Order {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentStatus   PaymentStatus  @default(PENDING) @map("payment_status")
  paymentMethod   String         @map("payment_method")
  totalAmount     Decimal        @map("total_amount") @db.Decimal(10, 2)
  addressId       String?       @map("address_id")
  address         Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  status          OrderStatus   @default(PENDING)
  shippingAddress Json          @map("shipping_address") // Immutable snapshot at time of purchase
  
  gatewayOrderId  String?       @unique @map("gateway_order_id")
  paymentId       String?       @unique @map("payment_id")
  items           OrderItem[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([gatewayOrderId])
  @@index([paymentId])
  @@map("orders")
  

  
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  title     String   // Snapshot of title at time of purchase
  size      String
  color     String
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2) // Authoritative price snapshot
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Address {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName           String   @map("first_name")
  lastName            String?  @map("last_name")
  addressLine1        String   @map("address_line1")
  addressLine2        String?  @map("address_line2")
  pincode             String
  state               String
  country             String   @default("India")
  deliveryInstruction String?  @map("delivery_instruction")
  isPrimary           Boolean  @default(false) @map("is_primary")
  orders              Order[]  // Relation to orders placed using this address
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("addresses")
}



// prisma/schema.prisma

enum HitlStatus {
  PENDING
  APPROVED
  REJECTED
}

model HitlApproval {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  sessionId   String     @map("session_id")
  actionType  String     @map("action_type") // e.g. "ISSUE_REFUND"
  payload     Json       // Tool arguments & contextual snapshot
  amount      Decimal?   @db.Decimal(10, 2)
  status      HitlStatus @default(PENDING)
  reviewedBy  String?    @map("reviewed_by")
  rejectionReason String? @map("rejection_reason")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("hitl_approvals")
}

model KnowledgeDocument {
  id          String                      @id @default(uuid())
  title       String
  content     String                      @db.Text
  minRole     Role                        @default(USER) @map("min_role")
  department  String                      @default("support")
  embedding   Unsupported("vector(1536)")?
  searchVector Unsupported("tsvector")?   @map("search_vector")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  @@map("knowledge_documents")
}